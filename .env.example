# ========================================================
# KWANZACOBRO - VARIÁVEIS DE AMBIENTE (ENV)
# ========================================================
# Para deploy no VERCEL:
# Adicione estas variáveis em: Project Settings > Environment Variables
# --------------------------------------------------------

# 1. Conexão ao Supabase (Obrigatório para Frontend e Backend)
# URL do projeto Supabase (com https:// e sem /rest/v1/)
VITE_SUPABASE_URL=https://ckcwpcnsfennfjmjwoqp.supabase.co

# Chave anônima pública (publishable / anon key) do Supabase
VITE_SUPABASE_ANON_KEY=sb_publishable_U4Rgccyd4DrhKeI7AuVyCQ_tYnwa-6p

# Variáveis para compatibilidade com Node.js backend / Funções Vercel
SUPABASE_URL=https://ckcwpcnsfennfjmjwoqp.supabase.co
SUPABASE_ANON_KEY=sb_publishable_U4Rgccyd4DrhKeI7AuVyCQ_tYnwa-6p

# CHAVE SERVICE_ROLE EXCLUSIVA DO BACKEND (Funções Vercel / server.ts)
# NUNCA expor no frontend nem usar o prefixo VITE_
SUPABASE_SERVICE_ROLE_KEY=

# Configuração temporária protegida para redefinir palavra-passe do Super Admin via /api/admin/reset-super-admin-password
# Remover ou definir ENABLE_TEMP_SUPER_ADMIN_RESET=false após concluir a operação
SUPER_ADMIN_RESET_TOKEN=
ENABLE_TEMP_SUPER_ADMIN_RESET=true

# Palavra-passe temporária apenas para executar scripts/reset-super-admin-password.mjs localmente
# NEW_ADMIN_PASSWORD=

# 2. Configurações do Servidor
PORT=3000
NODE_ENV=production

# 3. Gateway de SMS Angola (+244) (Opcional)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=
SMS_SENDER_ID=KwanzaCobro

# 4. Chave Gemini API (Opcional, se utilizar funcionalidades de IA)
GEMINI_API_KEY=
