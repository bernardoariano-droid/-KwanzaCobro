VITE_SUPABASE_URL=https://ckcwpcnsfennfjmjwoqp.supabase.co

# Chave anônima pública (publishable / anon key) do Supabase
VITE_SUPABASE_ANON_KEY=sb_publishable_U4Rgccyd4DrhKeI7AuVyCQ_tYnwa-6p

# Variáveis para compatibilidade com Node.js backend (caso use server.ts)
SUPABASE_URL=https://ckcwpcnsfennfjmjwoqp.supabase.co
SUPABASE_ANON_KEY=sb_publishable_U4Rgccyd4DrhKeI7AuVyCQ_tYnwa-6p

# 2. Configurações do Servidor
PORT=3000
NODE_ENV=production

# 3. Gateway de SMS Angola (+244) (Opcional)
SMS_PROVIDER_API_KEY=
