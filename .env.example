# NEUROJUS / KwanzaCobro — modelo de variáveis de ambiente
# Na Vercel, configurar estas variáveis em Project Settings > Environment Variables.

# Supabase — chave pública anon/publishable (nunca service_role no frontend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Supabase — backend Vercel Functions (JWT validado + RLS)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Obrigatória apenas para provisionamento administrativo de contas Auth.
# Guardar como variável privada na Vercel; NUNCA usar prefixo VITE_ nem publicar no GitHub.
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY

# Servidor local de desenvolvimento
PORT=3000
NODE_ENV=development

# Gateway SMS Angola (opcional)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=
SMS_SENDER_ID=NEUROJUS

# Segredo para assinatura de sessões SMS. Gerar um valor aleatório longo e único.
SESSION_SECRET=

# IA Gemini (opcional)
GEMINI_API_KEY=
